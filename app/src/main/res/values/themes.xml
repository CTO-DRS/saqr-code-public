<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.SaqrCode" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/saqr_bg</item>
        <item name="android:statusBarColor">@color/saqr_bg</item>
        <item name="android:navigationBarColor">@color/saqr_bg</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <!-- Android 12+ splash (core-splashscreen backports it to API 26). -->
    <style name="Theme.SaqrCode.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/saqr_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_saqr_splash</item>
        <item name="postSplashScreenTheme">@style/Theme.SaqrCode</item>
    </style>
</resources>
